--================ EFFECTS =================--
local function ripple(btn)
    btn.MouseButton1Down:Connect(function(x,y)
        local c = Instance.new("Frame", btn)
        c.Size = UDim2.new(0,0,0,0)
        c.Position = UDim2.new(0, x - btn.AbsolutePosition.X, 0, y - btn.AbsolutePosition.Y)
        c.BackgroundColor3 = Color3.new(1,1,1)
        c.BackgroundTransparency = 0.5
        Instance.new("UICorner", c).CornerRadius = UDim.new(1,0)
        TweenService:Create(c, TweenInfo.new(0.35), {
            Size = UDim2.new(0,180,0,180),
            BackgroundTransparency = 1
        }):Play()
        task.delay(0.35, function() c:Destroy() end)
    end)
end

local function hover(btn)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), {
            BackgroundColor3 = Theme.Primary
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), {
            BackgroundColor3 = Theme.Accent
        }):Play()
    end)
end

--================ TABS =================--
local tabs = {}

local function createTab(name)
    local btn = Instance.new("TextButton", tabBar)
    btn.Size = UDim2.new(1,0,0,40)
    btn.Text = name
    btn.BackgroundColor3 = Theme.Accent
    btn.TextColor3 = Theme.Text
    ripple(btn); hover(btn)

    local page = Instance.new("Frame", content)
    page.Size = UDim2.new(1,0,1,0)
    page.Visible = false
    page.BackgroundTransparency = 1

    local layout = Instance.new("UIListLayout", page)
    layout.Padding = UDim.new(0,8)

    btn.MouseButton1Click:Connect(function()
        for _,p in ipairs(tabs) do p.Visible = false end
        page.Visible = true
    end)

    table.insert(tabs, page)
    if #tabs == 1 then page.Visible = true end
    return page
end

