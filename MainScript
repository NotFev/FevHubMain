--================ COMPONENTS =================--
local function createToggle(parent, label, key)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(1,-10,0,30)
    b.BackgroundColor3 = Theme.Accent
    b.TextColor3 = Theme.Text
    ripple(b); hover(b)

    local function render(v)
        b.Text = (v and "[ON] " or "[OFF] ") .. label
    end

    local state = Engine:Get(key) or false
    render(state)

    b.MouseButton1Click:Connect(function()
        state = not state
        Engine:Set(key, state)
        Engine:Emit(key, state) -- event name == key
        render(state)
    end)
end

local function createSlider(parent, label, key, min, max)
    local holder = Instance.new("Frame", parent)
    holder.Size = UDim2.new(1,-10,0,42)
    holder.BackgroundTransparency = 1

    local txt = Instance.new("TextLabel", holder)
    txt.Size = UDim2.new(1,0,0,18)
    txt.BackgroundTransparency = 1
    txt.TextColor3 = Theme.Text

    local bar = Instance.new("Frame", holder)
    bar.Size = UDim2.new(1,0,0,10)
    bar.Position = UDim2.new(0,0,0,24)
    bar.BackgroundColor3 = Theme.Dark

    local fill = Instance.new("Frame", bar)
    fill.BackgroundColor3 = Theme.Primary
    fill.Size = UDim2.new(0,0,1,0)

    local val = Engine:Get(key) or min
    local function render(v)
        local p = (v - min)/(max - min)
        fill.Size = UDim2.new(p,0,1,0)
        txt.Text = label .. ": " .. tostring(v)
    end
    render(val)

    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            local move; move = UIS.InputChanged:Connect(function(ii)
                if ii.UserInputType == Enum.UserInputType.MouseMovement then
                    local pct = math.clamp((ii.Position.X - bar.AbsolutePosition.X)/bar.AbsoluteSize.X, 0, 1)
                    val = math.floor(min + (max-min)*pct)
                    Engine:Set(key, val)
                    Engine:Emit(key, val)
                    render(val)
                end
            end)
            UIS.InputEnded:Connect(function()
                if move then move:Disconnect() end
            end)
        end
    end)
end

local function createDropdown(parent, label, key, options)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(1,-10,0,30)
    b.BackgroundColor3 = Theme.Accent
    b.TextColor3 = Theme.Text
    ripple(b); hover(b)

    local idx = 1
    local current = Engine:Get(key) or options[1]
    for i,v in ipairs(options) do if v == current then idx = i break end end

    local function render()
        b.Text = label .. ": " .. tostring(options[idx])
    end
    render()

    b.MouseButton1Click:Connect(function()
        idx = idx % #options + 1
        current = options[idx]
        Engine:Set(key, current)
        Engine:Emit(key, current)
        render()
    end)
end

--================ NOTIFY =================--
local function notify(msg)
    local n = Instance.new("TextLabel", gui)
    n.Size = UDim2.new(0,220,0,40)
    n.Position = UDim2.new(1,-230,1,-60)
    n.BackgroundColor3 = Theme.Accent
    n.Text = msg
    n.TextColor3 = Theme.Text
    Instance.new("UICorner", n).CornerRadius = UDim.new(0,10)

    TweenService:Create(n, TweenInfo.new(0.25), {
        Position = UDim2.new(1,-230,1,-110)
    }):Play()

    task.delay(2, function()
        if n then n:Destroy() end
    end)
end

--================ SIMPLE KEY GATE =================--
local function keyGate(validKeys)
    local box = Instance.new("TextBox", gui)
    box.Size = UDim2.new(0,220,0,40)
    box.Position = UDim2.new(0.5,0,0.5,0)
    box.AnchorPoint = Vector2.new(0.5,0.5)
    box.PlaceholderText = "Enter Key"
    box.BackgroundColor3 = Theme.Light
    box.TextColor3 = Theme.Text
    Instance.new("UICorner", box).CornerRadius = UDim.new(0,10)

    local done = false
    box.FocusLost:Connect(function()
        if done then return end
        if validKeys[box.Text] then
            done = true
            box:Destroy()
            notify("Access granted")
        else
            box.Text = ""
            notify("Invalid key")
        end
    end)

    repeat task.wait() until done
end

--================ PLUGINS =================--
local Plugins = {}

function Plugins:Register(name, init)
    Engine.Modules[name] = init
end

function Plugins:LoadAll()
    for name, fn in pairs(Engine.Modules) do
        task.spawn(function()
            local ok, err = pcall(function() fn(Engine) end)
            if not ok then warn("Plugin error:", name, err) end
        end)
    end
end

