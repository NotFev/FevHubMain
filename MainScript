-- ULTRA Tween Engine local function tweenTo(cf) local root = getChar():FindFirstChild("HumanoidRootPart") if not root then return end

local dist = (root.Position - cf.Position).Magnitude
local time = math.clamp(dist / 180, 0.05, 2.5)

TweenService:Create(root, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = cf}):Play()

end

-- AI Combat Brain local function combatAI(target) local patterns = { Vector3.new(0,0,4), Vector3.new(5,0,5), Vector3.new(-5,0,5), Vector3.new(3,0,7) }

local pick = patterns[math.random(1,#patterns)]
tweenTo(target.HumanoidRootPart.CFrame * CFrame.new(pick))

end

-- Target System local function getTarget() local root = getChar():FindFirstChild("HumanoidRootPart") if not root then return end

local best, dist = nil, math.huge

for _, enemy in ipairs(Workspace.Enemies:GetChildren()) do
    local hum = enemy:FindFirstChild("Humanoid")
    local hrp = enemy:FindFirstChild("HumanoidRootPart")

    if hum and hrp and hum.Health > 0 then
        local d = (root.Position - hrp.Position).Magnitude
        local boss = hum.MaxHealth > 8000 or enemy.Name:lower():find("boss")

        if d < dist and d <= getgenv().FevHub.FarmDistance then
            if (getgenv().FevHub.AutoBoss and boss) or (not getgenv().FevHub.AutoBoss) then
                best = enemy
                dist = d
            end
        end
    end
end
return best

end

